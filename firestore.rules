rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The presenter's Google account. Add a co-instructor's address to the list.
    function isPresenter() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['kammain@gmail.com'];
    }

    // Live state for each lesson: slide, build step, numbers, spotlighted question.
    match /live/{lesson} {
      allow read: if true;
      allow write: if isPresenter()
                   && request.resource.data.keys().hasOnly(['slide', 'step', 'params', 'spot'])
                   && request.resource.data.slide is int
                   && request.resource.data.params is map;
    }

    // Student questions: anyone with the link can post (anonymously) and read.
    // Only the presenter can answer or delete.
    match /questions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['lesson', 'slide', 'text', 'ts'])
                    && request.resource.data.lesson is string && request.resource.data.lesson.size() <= 40
                    && request.resource.data.slide is int
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
                    && request.resource.data.ts == request.time;
      allow update: if isPresenter()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredAt']);
      allow delete: if isPresenter();
    }

    // Practice answers: students add one record per check. Only the presenter can see or clear them.
    match /responses/{id} {
      allow create: if request.resource.data.keys().hasOnly(['lesson', 'slide', 'key', 'ok', 'sid', 'ts'])
                    && request.resource.data.lesson is string && request.resource.data.lesson.size() <= 40
                    && request.resource.data.key is string && request.resource.data.key.size() <= 40
                    && request.resource.data.sid is string && request.resource.data.sid.size() <= 40
                    && request.resource.data.ok is bool
                    && request.resource.data.slide is int
                    && request.resource.data.ts == request.time;
      allow read, delete: if isPresenter();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
