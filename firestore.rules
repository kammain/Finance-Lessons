rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Live state for each lesson deck: live/lesson3, live/lesson4, ...
    match /live/{lesson} {
      // Anyone with the link can follow along. No sign-in needed.
      allow read: if true;
      // Only the presenter's Google account can change what students see.
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email in ['kammain@gmail.com']
                   && request.resource.data.keys().hasOnly(['slide', 'params'])
                   && request.resource.data.slide is int
                   && request.resource.data.params is map;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
